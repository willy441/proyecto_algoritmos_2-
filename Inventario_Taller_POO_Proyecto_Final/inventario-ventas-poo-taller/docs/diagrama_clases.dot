digraph clases {
 graph [rankdir=LR, fontname="Arial", label="Diagrama de clases — Inventario Taller", labelloc=t, fontsize=20, nodesep=0.5, ranksep=0.8];
 node [shape=record,fontname="Arial",fontsize=10]; edge [fontname="Arial",fontsize=9];
 Producto [label="{Producto|- _codigo: str\l- _nombre: str\l- _categoria: str\l- _precio: float\l- _stock: int\l|+ descontar_stock(cantidad: int): None\l+ necesita_reabastecer(minimo: int): bool\l+ validar_codigo(codigo: str): bool\l+ desde_fila_csv(fila: dict): Producto\l+ a_fila_csv(): dict\l+ __str__(): str\l+ __repr__(): str\l}"];
 Venta [label="{Venta (inmutable)|+ fecha_hora: datetime\l+ codigo: str\l+ cantidad: int\l+ total: float\l|+ __str__(): str\l+ __repr__(): str\l}"];
 Inventario [label="{Inventario|- _productos: dict[str, Producto]\l|+ agregar(producto: Producto): None\l+ obtener(codigo: str): Producto\l+ buscar(termino: str): list[Producto]\l+ ordenar(criterio: str): list[Producto]\l+ categorias(): set[str]\l+ eliminar(codigo: str): Producto\l+ __len__(): int\l}"];
 ReglaStock [label="{ReglaStock «abstract»|# _minimo: int\l|+ evaluar(producto: Producto): str «abstract»\l}"];
 AlertaStockMinimo [label="{AlertaStockMinimo|+ evaluar(producto: Producto): str\l}"];
 EstadoStock [label="{EstadoStock|+ evaluar(producto: Producto): str\l}"];
 RepositorioCSV [label="{RepositorioCSV|- _ruta_inventario: Path\l- _ruta_ventas: Path\l|+ cargar_productos(): Inventario\l+ guardar_productos(inventario: Inventario): None\l+ cargar_ventas(): list[Venta]\l+ guardar_venta(venta: Venta): None\l}"];
 Bitacora [label="{Bitacora|- _ruta: Path\l|+ registrar(accion: str): None\l}"];
 ReporteVentas [label="{ReporteVentas|+ generar(ventas: list[Venta], dia: date): str\l}"];
 SistemaInventario [label="{SistemaInventario|- _inventario: Inventario\l- _ventas: list[Venta]\l- _repositorio: RepositorioCSV\l- _bitacora: Bitacora\l- _reglas: list[ReglaStock]\l|+ iniciar(): None\l+ ejecutar(): None\l+ registrar_producto(...): Producto\l+ registrar_venta(codigo: str, cantidad: int): Venta\l+ eliminar_producto(codigo: str): Producto\l}"];
 Inventario -> Producto [dir=both,arrowtail=diamond,arrowhead=none,label="1 a 0..*",color=black];
 SistemaInventario -> Inventario [dir=both,arrowtail=diamond,arrowhead=none,label="1 a 1"];
 SistemaInventario -> RepositorioCSV [dir=both,arrowtail=diamond,arrowhead=none,label="1 a 1"];
 SistemaInventario -> Bitacora [dir=both,arrowtail=diamond,arrowhead=none,label="1 a 1"];
 SistemaInventario -> ReporteVentas [arrowhead=vee,style=dashed,label="usa"];
 SistemaInventario -> Venta [arrowhead=vee,label="0..* ventas"];
 SistemaInventario -> ReglaStock [arrowhead=vee,label="0..* reglas"];
 RepositorioCSV -> Producto [arrowhead=vee,style=dashed,label="serializa"];
 RepositorioCSV -> Venta [arrowhead=vee,style=dashed,label="persiste"];
 ReporteVentas -> Venta [arrowhead=vee,style=dashed,label="lee"];
 ReglaStock -> Producto [arrowhead=vee,style=dashed,label="evalúa"];
 AlertaStockMinimo -> ReglaStock [arrowhead=empty,label="hereda"];
 EstadoStock -> ReglaStock [arrowhead=empty,label="hereda"];
 subgraph cluster_excepciones {
 label="Excepciones personalizadas"; fontsize=11;
 InventarioError [label="{InventarioError|Exception}"];
 CodigoInvalidoError [label="{CodigoInvalidoError|InventarioError}"];
 ProductoNoEncontradoError [label="{ProductoNoEncontradoError|InventarioError}"];
 StockInsuficienteError [label="{StockInsuficienteError|InventarioError}"];
 ProductoDuplicadoError [label="{ProductoDuplicadoError|InventarioError}"];
 DatoInvalidoError [label="{DatoInvalidoError|InventarioError}"];
 PersistenciaError [label="{PersistenciaError|InventarioError}"];
 }
 CodigoInvalidoError -> InventarioError [arrowhead=empty]; ProductoNoEncontradoError -> InventarioError [arrowhead=empty];
 StockInsuficienteError -> InventarioError [arrowhead=empty]; ProductoDuplicadoError -> InventarioError [arrowhead=empty];
 DatoInvalidoError -> InventarioError [arrowhead=empty]; PersistenciaError -> InventarioError [arrowhead=empty];
}
